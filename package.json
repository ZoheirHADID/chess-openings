{
  "name": "chess-openings",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visualisation arborescente des ouvertures d'echecs (donnees Lichess) avec suivi de progression",
  "scripts": {
    "data": "node scripts/build-openings.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify": "node scripts/verify.mjs",
    "smoke": "vite build --ssr scripts/smoke.tsx --outDir dist-ssr --logLevel warn && node dist-ssr/smoke.js",
    "pieces": "node scripts/build-pieces.mjs",
    "engine": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "prepreview": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
